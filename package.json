{
  "name": "tutorial-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @studio/desktop tauri dev",
    "dev:web": "pnpm --filter @studio/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "engine": "pnpm --filter @studio/engine dev",
    "rec": "pnpm --filter @studio/engine exec tsx src/cli/rec.ts",
    "test:parity": "pnpm --filter @studio/desktop build && STUDIO_PARITY=1 vitest run parity",
    "test:recorder": "STUDIO_E2E=1 vitest run e2e",
    "package:engine": "node scripts/package-engine.mjs",
    "package": "pnpm --filter @studio/desktop build && pnpm package:engine && pnpm --filter @studio/desktop tauri build --bundles app --config src-tauri/tauri.bundle.conf.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^20.19.43",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
